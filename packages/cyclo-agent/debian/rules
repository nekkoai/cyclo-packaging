#!/usr/bin/make -f

export PYTHONDONTWRITEBYTECODE = 1

%:
	dh $@ --with python3

override_dh_auto_configure:
	:

override_dh_auto_build:
	rm -rf debian/build
	mkdir -p debian/build
	cp -a LICENSE README.md pyproject.toml src debian/build/
	sed -i \
		-e 's/setuptools==83\.0\.0/setuptools/' \
		-e 's/wheel==0\.47\.0/wheel/' \
		-e 's/license = "MIT"/license = { text = "MIT" }/' \
		-e '/^license-files = /d' \
		debian/build/pyproject.toml
	cd debian/build && python3 -m build --no-isolation --wheel --outdir dist

override_dh_auto_install:
	rm -rf debian/cyclo-agent
	python3 -m installer --destdir=debian/cyclo-agent --prefix=/usr \
		debian/build/dist/cyclo_agent-*.whl
	mkdir -p debian/cyclo-agent/usr/bin debian/cyclo-agent/usr/lib/python3/dist-packages
	mv debian/cyclo-agent/usr/local/bin/cyclo debian/cyclo-agent/usr/bin/cyclo
	site_packages=$$(find debian/cyclo-agent/usr/local/lib -type d -name dist-packages -print -quit); test -n "$$site_packages"; cp -a "$$site_packages"/. debian/cyclo-agent/usr/lib/python3/dist-packages/
	rm -rf debian/cyclo-agent/usr/local

override_dh_auto_test:
	:
