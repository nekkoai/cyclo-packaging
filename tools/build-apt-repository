#!/bin/sh
# Assemble a flat, unsigned APT repository suitable for GitHub Release assets.
set -eu

fail() {
    printf '%s\n' "build apt repository: $*" >&2
    exit 1
}

[ "$#" -ge 1 ] && [ "$#" -le 2 ] \
    || fail "usage: tools/build-apt-repository ARTIFACT_DIRECTORY [REPOSITORY_DIRECTORY]"

artifacts=$1
[ -d "$artifacts" ] || fail "not a directory: $artifacts"
artifacts=$(CDPATH= cd -- "$artifacts" && pwd)
repository=${2:-"$artifacts/apt-repository"}
case $repository in
    /*) ;;
    *) repository=$PWD/$repository ;;
esac
[ ! -e "$repository" ] && [ ! -L "$repository" ] \
    || fail "repository already exists: $repository"

command -v apt-ftparchive >/dev/null 2>&1 \
    || fail "apt-ftparchive is required (install apt-utils)"
command -v gzip >/dev/null 2>&1 || fail "gzip is required"

repository_parent=$(dirname -- "$repository")
mkdir -p "$repository_parent"
stage=$(mktemp -d "$repository_parent/.apt-repository.XXXXXX")
cleanup() {
    status=$?
    trap - 0
    rm -rf -- "$stage"
    exit "$status"
}
trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# GitHub Release assets are addressed as /releases/download/TAG/ASSET. Keep the
# Packages index and every referenced package at that same flat URL level.
find "$artifacts" -path "$stage" -prune -o \
    -type f \( -name '*.deb' -o -name '*.ddeb' \) \
    -exec cp -a -- {} "$stage/" \;
set -- "$stage"/*.deb "$stage"/*.ddeb
[ -f "$1" ] || fail "no .deb or .ddeb package found under $artifacts"

(
    cd "$stage"
    apt-ftparchive packages . > Packages
    gzip -9n -k Packages
    apt-ftparchive \
        -o APT::FTPArchive::Release::Origin="Nekko AI" \
        -o APT::FTPArchive::Release::Label="Cyclo" \
        -o APT::FTPArchive::Release::Suite="stable" \
        -o APT::FTPArchive::Release::Codename="stable" \
        -o APT::FTPArchive::Release::Architectures="amd64" \
        release . > Release
)

cat > "$stage/README.md" <<'EOF'
# Cyclo flat APT repository

This is an unsigned, flat APT repository. Its files are uploaded individually
as assets of a public GitHub Release so APT can resolve both `Packages.gz` and
package files from one URL base.

For the most recently published package release:

```sh
echo 'deb [trusted=yes] https://github.com/nekkoai/cyclo-packaging/releases/latest/download/ ./' | \
  sudo tee /etc/apt/sources.list.d/cyclo.list
sudo apt update
sudo apt install cyclo dcomp cyclo-provider-pooler
```

To pin a specific release, replace `latest` with its `apt-<run-id>` release tag.
The GitHub repository and release must be public for unauthenticated APT
clients. `[trusted=yes]` deliberately bypasses APT signature verification and
is only a bootstrap mechanism; use signed repository metadata before relying
on this for a hostile or production environment.
EOF

mv "$stage" "$repository"
stage=

cat > "$artifacts/README.md" <<'EOF'
# Cyclo Debian package artifact

This artifact contains a flat unsigned APT repository at `apt-repository/`.
The workflow also uploads every file in that directory as a GitHub Release
asset. For a public repository, servers can use the release's stable asset URL:

```sh
echo 'deb [trusted=yes] https://github.com/nekkoai/cyclo-packaging/releases/latest/download/ ./' | \
  sudo tee /etc/apt/sources.list.d/cyclo.list
sudo apt update
sudo apt install cyclo dcomp cyclo-provider-pooler
```

Pin a server to a specific build by replacing `latest` with `apt-<run-id>`.
The repository is intentionally unsigned for now, so `[trusted=yes]` is
required. Keep Ubuntu's normal package sources enabled because these packages
depend on system packages such as Docker Engine, Git, and Python.
EOF

printf '%s\n' "build apt repository: PASS"
printf '%s\n' "repository: $repository"
